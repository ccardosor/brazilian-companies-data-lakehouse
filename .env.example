# Receita Federal public WebDAV endpoint.
CNPJ_BASE_URL=https://arquivos.receitafederal.gov.br/public.php/dav/files/YggdBLfdninEJX9/

# Optional. If omitted, the pipeline uses the latest YYYY-MM directory available.
CNPJ_TARGET_MONTH=2026-08

# Local ingestion.
LOCAL_BASE_DIR=./downloads
LOCAL_LAKEHOUSE_DIR=./downloads/lakehouse

# S3 ingestion.
S3_BUCKET_NAME=your-bucket-name
S3_PREFIX_ROOT=raw/cnpj
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_ENDPOINT_URL=http://localhost:9000
