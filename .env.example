# Receita Federal public WebDAV endpoint.
CNPJ_BASE_URL=https://arquivos.receitafederal.gov.br/public.php/dav/files/YggdBLfdninEJX9/

# Optional. If omitted, the pipeline uses the latest YYYY-MM directory available.
CNPJ_TARGET_MONTH=2026-08

# Local ingestion.
CNPJ_DESTINATION=local
LOCAL_BASE_DIR=./downloads
LOCAL_LAKEHOUSE_DIR=./downloads/lakehouse

# S3 ingestion.
S3_BUCKET_NAME=your-bucket-name
S3_PREFIX_ROOT=raw/cnpj
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Prefixo do lakehouse dentro do bucket, usado pelo comando parquet-s3.
# Os Parquets ficam em <S3_LAKEHOUSE_PREFIX_ROOT>/raw/cnpj/<entidade>/ano_mes=<YYYY-MM>/.
# Deixe vazio para gravar na raiz do bucket.
S3_LAKEHOUSE_PREFIX_ROOT=lakehouse

# Object storage compativel com S3 (MinIO, Ceph, R2). Descomente para usar.
# S3_ENDPOINT_URL=http://localhost:9000
# Estilo de URL das requisicoes: path (exigido pelo MinIO) ou vhost (padrao da AWS).
# Quando S3_ENDPOINT_URL esta definido, o padrao ja e path.
# S3_URL_STYLE=path
# SSL na conexao com o object storage. Por padrao segue o esquema do endpoint:
# http:// desliga, https:// ou endpoint ausente liga.
# S3_USE_SSL=false
